sh /jffs/scripts/firewall start skynetloc=/tmp/mnt/gateway/skynet # Skynet

# --- Local-only IPv6 filtering -------------------------------------------
# Idempotent: delete-then-insert so repeated firewall restarts don't stack rules
for R in "-p udp --dport 53 -j REJECT" "-p tcp --dport 53 -j REJECT" \
         "-p udp --dport 547 -j ACCEPT" "-p ipv6-icmp -j ACCEPT"; do
  ip6tables -D INPUT -i br0 $R 2>/dev/null
  ip6tables -I INPUT -i br0 $R
done
# Nothing from the LAN is ever routed out another interface over IPv6
ip6tables -D FORWARD -i br0 ! -o br0 -j DROP 2>/dev/null
ip6tables -I FORWARD -i br0 ! -o br0 -j DROP
# Let the router send IPv6 to the LAN (router announcements, neighbor replies, DHCPv6, ping replies)
ip6tables -D OUTPUT -o br0 -j ACCEPT 2>/dev/null
ip6tables -I OUTPUT -o br0 -j ACCEPT
ip6tables -D INPUT -i lo -j ACCEPT 2>/dev/null; ip6tables -I INPUT -i lo -j ACCEPT
ip6tables -D OUTPUT -o lo -j ACCEPT 2>/dev/null; ip6tables -I OUTPUT -o lo -j ACCEPT
# --- end local-only IPv6 filtering ---------------------------------------

# --- Homebridge -> Kasa on guest network (one-way) ---
GBR=$(ip -4 -o addr show | awk '/192\.168\.101\./ {print $2; exit}')   # guest bridge name
HB=192.168.50.5,192.168.50.6,192.168.50.7                               # k3s nodes (Homebridge may run on any)
if [ -n "$GBR" ]; then
  iptables -D FORWARD -i br0 -s $HB -o $GBR -d 192.168.101.0/24 -j ACCEPT 2>/dev/null
  iptables -I FORWARD -i br0 -s $HB -o $GBR -d 192.168.101.0/24 -j ACCEPT
  iptables -D FORWARD -i $GBR -o br0 -d $HB -m state --state ESTABLISHED,RELATED -j ACCEPT 2>/dev/null
  iptables -I FORWARD -i $GBR -o br0 -d $HB -m state --state ESTABLISHED,RELATED -j ACCEPT
else
  logger -t firewall-start "guest bridge (192.168.101.x) not found; Homebridge->Kasa rules skipped"
fi
# --- end ---

sh /jffs/scripts/kasa-guest-allow.sh
